GROQ_API_KEY=your-groq-key-here
GOOGLE_API_KEY=your-gemini-key-here

# Postgres (keep "shop": the volume was created with it, and changing it here would NOT change the real password)
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop
# shop-api pool + cart settings (read by db.py / cache.py)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
CART_TTL_SECONDS=86400
LOG_LEVEL=INFO

# Background traffic (locust service)
LOCUST_USERS=10
LOCUST_SPAWN_RATE=2

# Grafana login (user is admin)
GRAFANA_ADMIN_PASSWORD=change-me