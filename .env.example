GROQ_API_KEY=your-groq-key-here
GOOGLE_API_KEY=your-gemini-key-here

# Postgres (keep "shop": the volume was created with it, and changing it here would NOT change the real password)
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop
# shop-api cart settings (read by cache.py)
CART_TTL_SECONDS=86400
LOG_LEVEL=INFO

# Background traffic (locust service)
LOCUST_USERS=10
LOCUST_SPAWN_RATE=2

# Grafana login (user is admin)
GRAFANA_ADMIN_PASSWORD=change-me

# Langfuse tracing (optional; leave empty to run without tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com


# GitHub (deploy_agent / diff_agent read deploy-* tags and diffs)
GITHUB_REPO=Santo-15/incident-rca-agent
GITHUB_TOKEN=                      # optional: raises the GitHub API limit from 60 to 5000 requests/hour

# Agent tools (defaults work for the local Docker stack)
LOKI_URL=http://127.0.0.1:3100
PROMETHEUS_URL=http://127.0.0.1:9090
ALERTMANAGER_URL=http://127.0.0.1:9093
LOCUST_URL=http://127.0.0.1:8089
LOGS_BACKEND=loki
METRICS_BACKEND=prometheus
RCA_MEMORY=on                      # off = run without past-incident memory (ablation)

# RCA API (agent/api.py)
RCA_SETTLE_S=90                    # wait for related alerts before diagnosing
RCA_CHAOS_S=420                    # how long a "Break it" outage lasts before auto-restore
RCA_CHAOS_COOLDOWN_S=600           # healthy time between outages (metrics baseline)

# UI (ui/app.py)
RCA_API_URL=http://127.0.0.1:8001