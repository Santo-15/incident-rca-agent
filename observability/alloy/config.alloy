// find the containers of this Compose project through the Docker socket
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"                                  
  filter {
    name   = "label"                                                    
    values = ["com.docker.compose.project=incident-rca-agent"]          
  }
}


discovery.relabel "rca" {
  targets = discovery.docker.containers.targets                        
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]   
    regex         = "shop-api|postgres|redis"                          
    action        = "keep"                                             
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]   
    target_label  = "service"                                          
  }
}

// follow each kept container's stdout and send the lines on
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"                           
  targets    = discovery.relabel.rca.output                            
  labels     = {"env" = "local"}                                       
  forward_to = [loki.write.local.receiver]                             
}

// push batches of lines to Loki
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"                          
  }
}