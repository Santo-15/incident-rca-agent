{
  "uid": "shop-overview",
  "title": "Shop overview",
  "tags": ["shop", "rca"],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "15s",
  "editable": true,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Is it up?",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"shop-api\"}", "legendFormat": "shop-api" },
        { "refId": "B", "expr": "pg_up", "legendFormat": "postgres" },
        { "refId": "C", "expr": "redis_up", "legendFormat": "redis" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": {
        "mappings": [ { "type": "value", "options": {
          "0": { "text": "DOWN", "color": "red", "index": 0 },
          "1": { "text": "UP", "color": "green", "index": 1 } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
      } }
    },
    {
      "id": 2, "type": "timeseries", "title": "5xx error ratio",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "shop:http_requests_5xx:ratio_rate5m", "legendFormat": "5xx share" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 3, "type": "timeseries", "title": "Requests per second by path",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "path:http_requests:rate5m", "legendFormat": "{{path}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 4, "type": "timeseries", "title": "p95 latency by path",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "path:http_request_duration_seconds:p95_5m", "legendFormat": "{{path}}" } ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Postgres connections by state",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (state) (pg_stat_activity_count{datname=\"shop\"})", "legendFormat": "{{state}}" } ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "shop-api memory (RSS)",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "process_resident_memory_bytes{job=\"shop-api\"}", "legendFormat": "RSS" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 7, "type": "logs", "title": "shop-api error lines",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "{service=\"shop-api\"} |= \"request failed\" | json | line_format \"{{.request_id}} {{.path}} {{.error}}\"" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}